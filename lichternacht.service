[Unit]
Description=Lichternacht Streckenplaner (Bechhofen)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lichternacht
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
